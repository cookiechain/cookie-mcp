{
  "name": "cookie-mcp",
  "version": "0.8.0",
  "mcpName": "io.github.cookiechain/cookie-mcp",
  "description": "MCP server + library for Cookie Chain — read market data, swap, launch tokens, and manage liquidity from any AI agent. Signs locally or hands verified transactions to the user's own wallet.",
  "license": "MIT",
  "author": "Cookie Chain community developers",
  "type": "module",
  "homepage": "https://github.com/cookiechain/cookie-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cookiechain/cookie-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/cookiechain/cookie-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cookie-chain",
    "solana",
    "defi",
    "ai-agents",
    "trading",
    "stdio"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@1.22.22",
  "bin": {
    "cookie-mcp": "dist/mcp/server.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/mcp/createServer.d.ts",
      "import": "./dist/mcp/createServer.js"
    },
    "./signer": {
      "types": "./dist/lib/signer.d.ts",
      "import": "./dist/lib/signer.js"
    },
    "./context": {
      "types": "./dist/lib/context.d.ts",
      "import": "./dist/lib/context.js"
    },
    "./submit": {
      "types": "./dist/lib/submit.d.ts",
      "import": "./dist/lib/submit.js"
    },
    "./errors": {
      "types": "./dist/lib/errors.d.ts",
      "import": "./dist/lib/errors.js"
    },
    "./quote": {
      "types": "./dist/lib/quote.d.ts",
      "import": "./dist/lib/quote.js"
    },
    "./balances": {
      "types": "./dist/lib/balances.d.ts",
      "import": "./dist/lib/balances.js"
    },
    "./trade": {
      "types": "./dist/lib/trade.d.ts",
      "import": "./dist/lib/trade.js"
    },
    "./transfer": {
      "types": "./dist/lib/transfer.d.ts",
      "import": "./dist/lib/transfer.js"
    },
    "./stake": {
      "types": "./dist/lib/stake.d.ts",
      "import": "./dist/lib/stake.js"
    },
    "./bridge": {
      "types": "./dist/lib/bridge.d.ts",
      "import": "./dist/lib/bridge.js"
    },
    "./bridge-routes": {
      "types": "./dist/lib/bridge-routes.d.ts",
      "import": "./dist/lib/bridge-routes.js"
    },
    "./limit-orders": {
      "types": "./dist/lib/limit-orders.d.ts",
      "import": "./dist/lib/limit-orders.js"
    },
    "./dca": {
      "types": "./dist/lib/dca.d.ts",
      "import": "./dist/lib/dca.js"
    },
    "./liquidity": {
      "types": "./dist/lib/liquidity.d.ts",
      "import": "./dist/lib/liquidity.js"
    },
    "./nft": {
      "types": "./dist/lib/nft.d.ts",
      "import": "./dist/lib/nft.js"
    },
    "./domains": {
      "types": "./dist/lib/domains.d.ts",
      "import": "./dist/lib/domains.js"
    },
    "./launchpad": {
      "types": "./dist/lib/launchpad.d.ts",
      "import": "./dist/lib/launchpad.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "mcp": "tsx src/mcp/server.ts",
    "build": "tsup",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --passWithNoTests",
    "smoke": "tsx scripts/smoke.ts",
    "release": "tsx scripts/release.ts",
    "test": "yarn lint && yarn format:check && yarn typecheck && yarn test:unit && yarn smoke",
    "prepublishOnly": "yarn build"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.0",
    "@meteora-ag/cp-amm-sdk": "^1.4.3",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@noble/curves": "^1",
    "@orca-so/common-sdk": "0.7.0",
    "@orca-so/whirlpools-sdk": "^0.20.0",
    "@raydium-io/raydium-sdk-v2": "0.2.41-alpha",
    "@solana/spl-token": "^0.4",
    "@solana/web3.js": "^1.98.0",
    "bn.js": "^5.2.1",
    "bs58": "^6",
    "decimal.js": "^10.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bn.js": "^5.1.6",
    "@types/node": "^22.10.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  }
}
