        {
          "name": "signer",
          "docs": [
            "The order's owner, or whoever holds the position NFT now (then `position_token_account` is",
            "required). Without the second case a transferred NFT could never be enabled by its new holder."
          ],
          "writable": true,
          "signer": true
        },
