  "types": [
    {
      "name": "Direction",
      "docs": [
        "Which way the position converts. `AToB` holds A and fills into B as the price rises, so the",
        "lower edge trails up; `BToA` holds B and fills into A as the price falls, so the upper edge",
        "trails down. A buy and a sell are the same order seen from the two tokens."
      ],
      "type": {
        "kind": "enum",
        "variants": [
          {
            "name": "AToB"
          },
          {
            "name": "BToA"
          }
        ]
      }
    },
