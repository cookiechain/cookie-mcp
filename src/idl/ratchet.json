    "name": "ratchet",
    "version": "0.1.0",
    "spec": "0.1.0",
    "description": "Trailing range orders for CookieBox CLMM positions: the filled part of the range is locked in and never reverses"
  },
  "instructions": [
    {
      "name": "disable",
      "docs": [
        "Owner, or whoever now holds the position NFT: cancel the order and revoke the delegation."
      ],
      "discriminator": [185, 173, 187, 90, 216, 15, 238, 233],
