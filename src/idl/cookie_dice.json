    {
      "name": "House",
      "docs": ["Global house state. One per deployment, at PDA `[\"house\"]`."],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "authority",
            "docs": [
              "Can change parameters, fund and withdraw. Should be a multisig in production; hand it",
              "over with `propose_authority` + `accept_authority`."
            ],
            "type": "pubkey"
          },
          {
            "name": "operator",
            "docs": [
              "Signs `settle_bet`. Kept hot, so the *key* is deliberately powerless beyond revealing",
              "seeds in order — it cannot move funds or change the odds. The seed chain it reveals from",
              "is another matter: whoever reads that file knows every future roll and can bet to win,",
              "so guard it like the bankroll."
            ],
            "type": "pubkey"
          },
          {
            "name": "treasury",
            "docs": ["Destination for withdrawn profit."],
            "type": "pubkey"
          },
          {
            "name": "seed_commitment",
            "docs": [
              "`sha256` of the next seed the operator must reveal. The entire future sequence is",
              "pinned to this one value; see `fairness.rs`."
            ],
            "type": {
              "array": ["u8", 32]
            }
          },
          {
            "name": "seed_index",
            "docs": [
              "How many seeds have been revealed. Recorded on each settled bet so a player can walk",
              "the chain even across expiries, which consume a nonce but no seed."
            ],
            "type": "u64"
          },
          {
            "name": "next_nonce",
            "docs": ["Next nonce to hand out at placement."],
            "type": "u64"
          },
          {
            "name": "settled_nonce",
            "docs": [
              "Next nonce that must be resolved. Settlement is strictly FIFO: without that, an",
              "operator holding the whole chain could compute every pending bet's outcome under the",
              "next seed and hand it to whichever player it wanted to lose."
            ],
            "type": "u64"
          },
          {
            "name": "locked_liability",
            "docs": [
              "Sum of full payouts (stake + profit) across unresolved bets — everything the vault owes",
              "players right now. `vault − locked_liability − rent` is the house's own free bankroll.",
              "(Before 2026-11-15 this held only `payout − stake`, which counted pending stakes as free.)"
            ],
            "type": "u64"
          },
          {
            "name": "edge_bps",
            "docs": ["House edge in basis points."],
            "type": "u16"
          },
          {
            "name": "max_payout_bps",
            "docs": ["Cap on one bet's profit as a share of the free bankroll, in basis points."],
            "type": "u16"
          },
          {
            "name": "min_bet",
            "docs": ["Minimum stake in lamports."],
            "type": "u64"
          },
          {
            "name": "settle_timeout_slots",
            "docs": [
              "Slots after placement before anyone may refund an unsettled bet (`expire_bet`)."
            ],
            "type": "u64"
          },
          {
            "name": "total_bets",
            "type": "u64"
          },
          {
            "name": "total_wagered",
            "type": "u128"
          },
          {
            "name": "total_paid",
            "type": "u128"
          },
          {
            "name": "expired_count",
            "docs": [
              "Bets the operator failed to settle in time and that were refunded. Permanent, public",
              "reputation counter."
            ],
            "type": "u64"
          },
          {
            "name": "paused",
            "type": "bool"
          },
          {
            "name": "bump",
            "type": "u8"
          },
          {
            "name": "vault_bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "HouseParams",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "edge_bps",
            "type": "u16"
          },
          {
            "name": "max_payout_bps",
            "type": "u16"
          },
          {
            "name": "min_bet",
            "type": "u64"
          },
          {
            "name": "settle_timeout_slots",
            "type": "u64"
          }
        ]
      }
    },
    {
      "name": "PendingAuthority",
      "docs": [
        "The key nominated to take over the house, at PDA `[\"pending_authority\"]`. Exists only",
        "between `propose_authority` and `accept_authority`."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "authority",
            "type": "pubkey"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "SeedChainRotated",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "previous_commitment",
            "type": {
              "array": ["u8", 32]
            }
          },
          {
            "name": "new_commitment",
            "type": {
              "array": ["u8", 32]
            }
          },
          {
            "name": "seed_index",
            "type": "u64"
          }
        ]
      }
    }
  ]
}
