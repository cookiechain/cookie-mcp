  "types": [
    {
      "name": "Dca",
      "docs": [
        "A dollar-cost-averaging schedule. See cookiebox `docs/DCA_ORDERS.md`.",
        "",
        "A DCA is a stop-market order that fires on a clock instead of on a price, N times: the same",
        "flash-fill sandwich settles it, but what authorises a cycle is `next_cycle_at` (the time",
        "gate) and `in_amount_per_cycle` (the slice cap) rather than a resting price."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "user",
            "type": "pubkey"
          },
          {
            "name": "input_mint",
            "type": "pubkey"
          },
          {
            "name": "output_mint",
            "type": "pubkey"
          },
          {
            "name": "waiting",
            "docs": [
              "A cycle is mid-flight: input released, proceeds not yet settled. The reentrancy guard —",
              "two releases against one settlement would drain the reserve."
            ],
            "type": "bool"
          },
          {
            "name": "in_deposited",
            "docs": [
              "Total input escrowed at open. Never changes; the remainder is `in_deposited - in_used`."
            ],
            "type": "u64"
          },
          {
            "name": "in_used",
            "docs": [
              "Cumulative input actually spent. With `out_received`, the average fill price."
            ],
            "type": "u64"
          },
          {
            "name": "out_received",
            "docs": ["Cumulative output delivered. Display only; no invariant reads it."],
            "type": "u64"
          },
          {
            "name": "in_amount_per_cycle",
            "docs": [
              "THE SLICE CAP. A cycle releases `min(in_amount_per_cycle, remaining)`, computed by the",
              "program and never passed by the keeper (GUARD D2)."
            ],
            "type": "u64"
          },
          {
            "name": "cycle_frequency",
            "docs": ["Seconds between cycles, bounded by MIN/MAX_CYCLE_FREQUENCY at open."],
            "type": "i64"
          },
          {
            "name": "next_cycle_at",
            "docs": [
              "THE TIME GATE. A cycle before this instant is refused (GUARD D1). Advanced exactly once",
              "per settled cycle, in `flash_fill_dca` (GUARD D3)."
            ],
            "type": "i64"
          },
          {
            "name": "borrow_in_amount",
            "docs": ["Set by `pre_flash_fill_dca`, consumed by `flash_fill_dca`."],
            "type": "u64"
          },
          {
            "name": "min_out_amount",
            "docs": [
              "Optional per-cycle band, in output units for one full `in_amount_per_cycle`; `0` =",
              "unset. **Both bounds constrain the OUTPUT**, so `min_out_amount` is the protective one",
              "in either direction — \"don't sell below X\" and \"don't buy above X\" are both a floor on",
              "what comes back. `max_out_amount` refuses a cycle whose output is implausibly good: a",
              "manipulated-pool guard, not a price ceiling (GUARD D4)."
            ],
            "type": "u64"
          },
          {
            "name": "max_out_amount",
            "type": "u64"
          },
          {
            "name": "user_input_account",
            "docs": ["PINNED at open — a close refunds only here."],
            "type": "pubkey"
          },
          {
            "name": "user_output_account",
            "docs": ["PINNED at open — a cycle pays only here."],
            "type": "pubkey"
          },
          {
            "name": "reserve",
            "type": "pubkey"
          },
          {
            "name": "base",
            "docs": [
              "The PDA seed — a throwaway keypair the client generates and signs with, rather than a",
              "nonce counter, so concurrent schedules never race on a read-then-write."
            ],
            "type": "pubkey"
          },
          {
            "name": "created_at",
            "type": "i64"
          }
        ]
      }
    },
    {
      "name": "Fee",
      "docs": [
        "Global fee configuration — a singleton at `[\"fee\"]` that is *also* the token authority",
        "over every `program_fee_account`.",
        "",
        "The fee deliberately does not live on the `Dca`: keeping it here means it is",
        "retunable by the admin with no program upgrade and no account migration."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "maker_fee",
            "docs": [
              "Deducted from what the user receives on a cycle (Jupiter's platform fee): the user is",
              "paid `pay_amount - maker_fee`, the vault gets the difference. This is the fee that is",
              "real revenue — cycles are keeper-only, so a taker fee is our own keeper paying us,",
              "pocket to pocket."
            ],
            "type": "u64"
          },
          {
            "name": "maker_stable_fee",
            "type": "u64"
          },
          {
            "name": "taker_fee",
            "docs": [
              "Charged to the keeper on top of the payout, and counted against `max_taking_amount`.",
              "Zero at launch: there is no third-party taker to charge."
            ],
            "type": "u64"
          },
          {
            "name": "taker_stable_fee",
            "type": "u64"
          }
        ]
      }
    }
  ]
}
