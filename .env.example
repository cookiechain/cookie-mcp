# Cookie Chain RPC endpoint. Defaults to the public Cookiescan RPC.
COOKIE_RPC_URL=https://rpc.cookiescan.io

# Optional — unset means read-only mode. Base58 secret, solana-keygen JSON, or a keypair file path.
# NEVER commit a real key.
COOKIE_PRIVATE_KEY=

# Default slippage tolerance in basis points (500 = 5%).
COOKIE_SLIPPAGE_BPS=500

# Solana mainnet RPC. The public default is OK for `bridge` and reads, but `trade {chain:"solana"}`
# refuses it — set a dedicated RPC for more complex tasks (a free Helius/Shyft/QuickNode key is enough).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional Jupiter key (free tier available). Without it: lite-api.jup.ag at 0.5 req/s.
# JUPITER_API_KEY=
